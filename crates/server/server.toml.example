# server 配置样例:复制为 server.toml 并填入真实凭据(server.toml 已 gitignore)。

# 下游监听地址。公网暴露由 Nginx stream 块终结 TLS 后转发到本地址(见 README)。
listen = "127.0.0.1:9720"

# TOTP 密钥:必须为合法 Base32(仅 A-Z 与 2-7,不含 0/1/8/9,大小写不敏感)。
# 生成(Git Bash):head -c 20 /dev/urandom | base32 | tr -d '='
totp_secret = "JBSWY3DPEHPK3PXP"

# 仅本地开发:跳过 TOTP 校验,客户端连接对话框里任意 6 位码都放行
# (会话令牌逻辑不变)。默认 false;开启时启动与每次放行都打 warning。
# 切勿在任何公网可达的部署配置里打开。
#dev_skip_totp = true

# tracing 过滤级别(RUST_LOG 语法)。
log_level = "info"

[alpaca]
key_id = "PK..."
secret = "..."
# sip / iex / otc / delayed_sip / boats / overnight
feed = "delayed_sip"

[finviz]
token = "your-finviz-elite-token"

[deepseek]
api_key = "..."

# 可选:本机开发时的上游代理(VPS 上删除本节即可)。
#[proxy]
#ws_socks5 = "socks5://127.0.0.1:7890"
